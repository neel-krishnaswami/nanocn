// A refined function computing the length of a linked list,
// specified against the pure `length` over the corresponding Lst.

sort Lst(a) = {
    Nil : ()
  | Cons : (a * Lst(a))
}

type List(a) = {
    Nil : ()
  | Cons : (a * Ptr(List(a)))
}

// Pure length on a spec-level Lst.
fun length (xs : Lst(Int)) -> Int [spec] =
  case xs of {
      Nil u -> 0
    | Cons p -> let (x, xs') = p; 1 + length(xs')
  }

// Sequence the heap-allocated list into a spec Lst.
fun sequence (p : Ptr(List(Int))) -> Pred Lst(Int) [spec] =
  take v = Own[List(Int)](p);
  case v of {
      Nil u -> return (Nil ())
    | Cons pair -> let (x, q) = pair;
                   take xs = sequence(q);
                   return (Cons (x, xs))
  }

// Refined length: walks the heap list, returns (len, proof, resource).
//
// This example is being rewritten for the new resource-term syntax
// (return / take / unfold; / annot; replacing make-ret / make-take /
// unfold rpf).  The new [take(rpf1, rpf2)] form takes two rpfs (the
// witness and the body) where the OLD [make-take] took a CRT tuple.
// The proof needs reconstruction in the new style — for now [len2]
// uses [res unfold; take(v, own); rest = r] (the rpat side, which
// destructures), and the rpf side of the proof still has $holes
// where the new [take(_,_)] reconstruction goes.
rfun len2
    (p : Ptr(List(Int)),
     [res] r : (do xs : Lst(Int) = sequence(p)))
  -> (n : Int,
      [log] (n == length(xs)),
      [res] sequence(p)@xs)
  [impure] =
  let res unfold; take(v, own); rest = r;
  let (val, log pf, res own) = Get[List(Int)] (p, res own);
  case[val_eq] val of {
    Nil u -> let res case[foo] Nil(); let[u_eq] y; return[eq] = rest;
             (0,
              log auto,
              res $hole_reconstruct_nil)
  | Cons p -> $hole_reconstruct_cons
  }





main : () [impure] = ()
