// A refined function computing the length of a linked list,
// specified against the pure `length` over the corresponding Lst.

sort Lst(a) = {
    Nil : ()
  | Cons : (a * Lst(a))
}

type List(a) = {
    Nil : ()
  | Cons : (a * Ptr(List(a)))
}

// Length on a spec-level Lst.
fun length (xs : Lst(Int)) -> Int [spec] =
  case xs of {
      Nil u -> 0
    | Cons p -> let (x, xs') = p; 1 + length(xs')
  }

// Append on a spec-level Lst.
fun append (p : (Lst(Int) * Lst(Int))) -> Lst(Int) [spec] =
  case p of {
    (Nil(), ys) -> ys
  | (Cons(x, xs), ys) -> Cons(x, append(xs, ys))
  }

// Sequence the heap-allocated list into a spec Lst.
fun sequence (p : Ptr(List(Int))) -> Pred Lst(Int) [spec] =
  take v = Own[List(Int)](p);
  case v of {
      Nil u -> return (Nil ())
    | Cons pair -> let (x, q) = pair;
                   take xs = sequence(q);
                   return (Cons (x, xs))
  }



// Refined length: walks the heap list, returns (len, proof, resource).
//
rfun len
    (p : Ptr(List(Int)),
     [res] r : (do xs : Lst(Int) = sequence(p)))
  -> (n : Int,
      [log] (n == length(xs)),
      [res] sequence(p)@xs
     )
  [impure] =
  let res unfold; take(v, own); rest = r;
  let log unfold_axiom = unfold length(xs); 
  let (val, log pf, res own) = Get[List(Int)] (p, res own);
  case[val_eq] val of {
    Nil u -> let res case[foo] Nil(); let[u_eq] y; return[eq] = rest;
             (0,
              log auto,
              res unfold; take(own, let[a1] v1;
                                    let [a2] v2;
                                    case[a3] Nil ();
                                    let [a4] ();
                                    return auto)
	     )
  | Cons p -> let res let[a1] val1; 
                      let[a2] val2;
                      case[a3] Cons(x, q);
                      let[a5] pair2;
		      let[a6] val6;
		      let[a7] (x',q');
		      let[a8] x'';
		      let[a9] q'';
		      take(xs''', seq);
		      let[b0] xs4;
		      return[b1]
               = rest; 
              let (m, log pf, res seq') = len(q, res seq);
	      (m+1, log auto, res unfold; 
                                  take(own,
	                               let[a1] v1;
                                       let[a2] v2;
                                       case[a3] Cons(b, bs);
                                       let[a4] v3;
                                       let[a5] v4;
                                       let[a6] (v5, v6);
                                       let[a7] x3;
                                       let[a8] q'';
                                       take(seq', let[a9] xs5; return auto)) )
  }

rfun app
    (p : Ptr(List(Int)),
     q : Ptr(List(Int)),
     [res] rp : (do xs : Lst(Int) = sequence(p)),
     [res] rq : (do ys : Lst(Int) = sequence(q)))
  -> (x : Ptr(List(Int)),
      [res] (do zs = sequence(x)),
      [log] (zs == append(xs, ys))
     ) [impure] = 
 $hole 




main : () [impure] = ()
